# NexusOps — copy to .env on the server and edit before `docker compose up`.
#   cp .env.server.example .env
#   docker compose -f docker-compose.server.yml up -d
#
# If you change POSTGRES_PASSWORD, also update DATABASE_URL to match.
# Do not use @ : / # ? in passwords unless you URL-encode them in DATABASE_URL.

# --- How browsers reach this host (DNS name or IP, no trailing slash) ---
PUBLIC_HOST=localhost

BACKEND_BIND=0.0.0.0
BACKEND_PORT=8000
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=5173
LDAPADMIN_BIND=0.0.0.0
LDAPADMIN_PORT=8082

# Database / Redis / LDAP listen on loopback only. Use 0.0.0.0 to expose them.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
LDAP_BIND=127.0.0.1
LDAP_PORT=389

# Must match PUBLIC_HOST + ports above (used for CORS and the UI API client).
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --- Images (published by GitHub Actions to GHCR) ---
NEXUSOPS_BACKEND_IMAGE=ghcr.io/thrinadsanjay/nexusops-backend:latest
NEXUSOPS_FRONTEND_IMAGE=ghcr.io/thrinadsanjay/nexusops-frontend:latest
PULL_POLICY=missing

# --- Application ---
APP_NAME=nexusops
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# --- First admin (created on empty database) ---
DEFAULT_ADMIN_EMAIL=admin@nexusops.local
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- Secrets (change these) ---
JWT_SECRET_KEY=change-me-in-production
SESSION_TIMEOUT_MINUTES=60

# --- PostgreSQL ---
POSTGRES_DB=nexusops
POSTGRES_USER=nexusops
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://nexusops:change-me@postgres:5432/nexusops

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- IPAM discovery (comma-separated CIDRs, optional) ---
SCAN_NETWORKS=

# --- Bundled OpenLDAP ---
LDAP_ORGANISATION=NexusOps Homelab
LDAP_DOMAIN=homelab.local
LDAP_BASE_DN=dc=homelab,dc=local
LDAP_ADMIN_PASSWORD=NexusOps2024!
LDAP_READONLY_USER=true
LDAP_READONLY_USER_USERNAME=readonly
LDAP_READONLY_USER_PASSWORD=readonly
